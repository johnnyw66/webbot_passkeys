# Base image with VNC + Chromium GUI
FROM mrcolorrain/vnc-browser@sha256:4196aba6dd116baa10cd7f5ec59b0789a04616c0488de893b1eb731647233548

# -------------------------------
# Install Python tooling
# -------------------------------
RUN apt-get update && \
    apt-get install -y python3-full python3-venv curl build-essential && \
    rm -rf /var/lib/apt/lists/*

# -------------------------------
# Create a Python virtual environment
# -------------------------------
RUN python3 -m venv /opt/playwright-env
ENV PATH="/opt/playwright-env/bin:$PATH"

# Upgrade pip inside the venv
RUN pip install --upgrade pip

# -------------------------------
# Install Playwright and browsers
# -------------------------------
RUN pip install playwright
RUN playwright install chromium

# -------------------------------
# Install VirtualHere client
# -------------------------------

# Docker automatically sets TARGETARCH when building under Mac OSX - Make sure you
# set this on other systems when building. eg.
# docker build \
#  --build-arg TARGETARCH=$(docker info --format '{{ .Architecture }}') \
# "${DOCKER_ARGS[@]}" \
#  -f Dockerfile.freeze \
#  -t webbot .

ARG TARGETARCH
RUN if [ "$TARGETARCH" = "aarch64" ]; then TARGETARCH="arm64"; fi && echo "TARGETARCH is: $TARGETARCH" && \
    if [ "$TARGETARCH" = "amd64" ]; then \
        echo "Building on AMD64 (x86_64)"; \
        curl -fsSL https://www.virtualhere.com/sites/default/files/usbclient/vhclientx86_64 -o /usr/local/bin/vhclient || \
            echo "WARNING: vhclient (amd64) not downloaded"; \
        chmod +x /usr/local/bin/vhclient || true; \
    elif [ "$TARGETARCH" = "arm64" ]; then \
        echo "Building on ARM64 (AArch64)"; \
        curl -fsSL https://www.virtualhere.com/sites/default/files/usbclient/vhclientarm64 -o /usr/local/bin/vhclient || \
            echo "WARNING: vhclient (arm64) not downloaded"; \
        chmod +x /usr/local/bin/vhclient || true; \
    elif [ "$TARGETARCH" = "arm" ]; then \
        echo "ARM (32-bit) NOT SUPPORTED"; \
    else \
        echo "Unknown architecture: $TARGETARCH"; \
    fi


# -------------------------------
# Copy application scripts
# -------------------------------
WORKDIR /app
COPY . /app

# Install Python dependencies if requirements.txt exists
RUN if [ -f requirements.txt ]; then pip install -r requirements.txt; fi

# -------------------------------
# Wrapper script to auto-run Python script and GUI
# -------------------------------
COPY start.sh /start.sh
RUN chmod +x /start.sh

# Set wrapper as entrypoint
ENTRYPOINT ["/start.sh"]
CMD ["/usr/local/bin/customizable_entrypoint.sh"]

